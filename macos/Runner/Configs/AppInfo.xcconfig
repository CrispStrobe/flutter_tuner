// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// NOTE: this also names the built bundle (CrispTuner.app) — the release
// workflow packages that exact filename.
PRODUCT_NAME = CrispTuner

// The application's bundle identifier.
// Deliberately identical to the iOS bundle id, so App Store Connect serves both
// platforms from ONE app record — creating an app record is one of the few
// steps Apple blocks via the API.
PRODUCT_BUNDLE_IDENTIFIER = com.crispstrobe.CrispTuner

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Christian Ströbele. All rights reserved.
