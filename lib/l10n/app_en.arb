  "about": "About",
  "@about": {
    "description": "Tooltip and title for the About screen"
  },
  "aboutTitle": "About CrispTuner",
  "aboutTagline": "Precise chromatic tuner for six instruments",
  "aboutServiceProvider": "Service Provider",
  "aboutLicense": "License",
  "aboutLicenseBody": "CrispTuner is licensed under the MIT License.\n\nYou are free to use, modify and distribute this software for any purpose, including commercial use.",
  "aboutComponents": "Open Source Components",
  "aboutComponentsIntro": "CrispTuner is built on these open source packages. The full license texts are available under “Open Source Licenses” below.",
  "aboutHowItWorks": "How It Works",
  "aboutHowItWorksBody": "Microphone audio is captured as 16-bit PCM at 44.1 kHz. Each 2048-sample block is analysed with the YIN algorithm to estimate pitch, then passed through a 5-sample median filter so the reading stays steady. The result is matched to the nearest note for your chosen concert pitch, and the deviation is shown in cents. In parallel a Hann-windowed FFT drives the spectrum display.",
  "aboutPrivacy": "Privacy",
  "aboutPrivacyBody": "Short version: CrispTuner collects nothing about you.\n\nMicrophone audio is analysed in real time on your device and is never recorded, stored or transmitted. There are no accounts, no analytics, no advertising and no tracking, and the app makes no network requests at all.\n\nOnly your A4 reference frequency and selected instrument are saved, locally, so they persist between launches. They are removed when you uninstall the app.",
  "aboutPrivacyPolicyLink": "Read the full privacy policy",
  "aboutDisclaimer": "Disclaimer",
  "aboutDisclaimerBody": "This software is provided “as is”, without warranty of any kind. The authors are not liable for any damages arising from the use of this software.",
  "aboutSourceCode": "Source Code",
  "aboutContributions": "Contributions welcome. Please open an issue first for major changes.",
  "aboutOpenSourceLicenses": "Open Source Licenses",
  "aboutCopied": "Copied to clipboard",
  "visualizationLabel": "{label} visualization",
  "@visualizationLabel": {
    "description": "Accessibility label for a chart",
    "placeholders": {
