{
  "@@locale": "en",

  "appTitle": "CrispTuner",
  "@appTitle": {
    "description": "Application name, shown in the title bar and task switcher"
  },

  "startTuning": "Start Tuning",
  "@startTuning": {
    "description": "Idle status shown before listening starts"
  },
  "listening": "Listening…",
  "@listening": {
    "description": "Status shown while the microphone is active but no note is detected"
  },
  "inTune": "In Tune ✓",
  "@inTune": {
    "description": "Status shown when the detected pitch is within 5 cents of the target"
  },
  "tooSharp": "Too Sharp ↑",
  "@tooSharp": {
    "description": "Status shown when the detected pitch is above the target"
  },
  "tooFlat": "Too Flat ↓",
  "@tooFlat": {
    "description": "Status shown when the detected pitch is below the target"
  },
  "playing": "Playing {note}",
  "@playing": {
    "description": "Status shown while a reference tone is sounding",
    "placeholders": {
      "note": {
        "type": "String",
        "example": "A"
      }
    }
  },
  "micPermissionDenied": "Microphone permission denied",
  "@micPermissionDenied": {
    "description": "Status shown when the user declined microphone access"
  },

  "pitchHistory": "Pitch History",
  "frequencySpectrum": "Frequency Spectrum",

  "hertzValue": "{hz} Hz",
  "@hertzValue": {
    "description": "A frequency reading, e.g. 440.00 Hz",
    "placeholders": {
      "hz": {
        "type": "String",
        "example": "440.00"
      }
    }
  },
  "a4Label": "A4: {hz} Hz",
  "@a4Label": {
    "description": "Label above the A4 concert-pitch slider",
    "placeholders": {
      "hz": {
        "type": "String",
        "example": "440.0"
      }
    }
  },
  "a4ReferenceFrequency": "A4 reference frequency",
  "@a4ReferenceFrequency": {
    "description": "Accessibility label for the A4 slider"
  },

  "instrumentGuitar": "Guitar",
  "instrumentCello": "Cello",
  "instrumentBass": "Bass",
  "instrumentViolin": "Violin",
  "instrumentUkulele": "Ukulele",
  "instrumentMandolin": "Mandolin",

  "defaultMicrophone": "Default mic",
  "selectMicrophone": "Select microphone input",

  "noNoteDetected": "No note detected. {status}",
  "@noNoteDetected": {
    "description": "Accessibility live-region text when nothing is detected",
    "placeholders": {
      "status": {
        "type": "String",
        "example": "Listening…"
      }
    }
  },
  "detectedNote": "Detected note: {note}. {status}",
  "@detectedNote": {
    "description": "Accessibility live-region text announcing the detected note",
    "placeholders": {
      "note": {
        "type": "String",
        "example": "A"
      },
      "status": {
        "type": "String",
        "example": "In Tune ✓"
      }
    }
  },
  "tuningMeterLabel": "Tuning meter: {cents} cents",
  "@tuningMeterLabel": {
    "description": "Accessibility label for the cents deviation meter",
    "placeholders": {
      "cents": {
        "type": "String",
        "example": "-12"
      }
    }
  },
  "playReferenceTone": "Play reference tone {note}",
  "@playReferenceTone": {
    "description": "Accessibility label for a string's play button",
    "placeholders": {
      "note": {
        "type": "String",
        "example": "A"
      }
    }
  },
  "stopReferenceTone": "Stop playing {note}",
  "@stopReferenceTone": {
    "description": "Accessibility label for a string's play button while sounding",
    "placeholders": {
      "note": {
        "type": "String",
        "example": "A"
      }
    }
  },
  "startTuningButton": "Start tuning",
  "stopTuningButton": "Stop tuning",
  "visualizationLabel": "{label} visualization",
  "@visualizationLabel": {
    "description": "Accessibility label for a chart",
    "placeholders": {
      "label": {
        "type": "String",
        "example": "Pitch History"
      }
    }
  }
}
