migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/key.properties
*.jks

# App Store Connect signing material — the .p8 private key must never be
# committed. The helper scripts in here are local-only tooling.
.appstoreconnect/
*.p8
*.p12
*.mobileprovision
*.provisionprofile

# Golden-test failure output (actual/diff images written on mismatch)
test/failures/

# Vercel CLI project link (holds the project/org ids; they live in CI secrets)
.vercel/

# Draft correspondence, not part of the project.
APPEAL.md

# Local UI preview renders — regenerate with
#   flutter test -t preview --update-goldens
test/goldens/preview/
